<% layout("./layouts/boilerplate") -%>

<div class="row justify-content-center">
  <div class="col-12 col-md-6 mt-4">

    <h3 class="text-center mb-3">Verify Your Email</h3>

    <form action="/verify-otp" method="post">
      <p class="text-muted text-center">
        Didn’t receive the email? Please check your Spam folder and mark it as “Not Spam”.
      </p>
      <input type="hidden" name="email" value="<%= email %>">

      <div class="mb-3">
        <label class="form-label">Enter OTP</label>
        <input
          type="text"
          name="otp"
          class="form-control"
          placeholder="6-digit OTP"
          required
        >
      </div>

      <p id="otp-timer" class="text-muted"></p>

      <div class="d-grid">
        <button class="btn btn-success add-btn">
          Verify OTP
        </button>
      </div>
    </form>

    <div class="d-grid mt-2">
      <button
        type="button"
        id="resendBtn"
        class="btn btn-link"
        disabled
      >
        Resend OTP (60s)
      </button>
    </div>

  </div>
</div>
